# Public site URL used for canonical links, structured data, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=https://kobbyops.vercel.app

# Google Search Console verification token only (not the complete meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase public settings. The anon key is safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ANALYTICS_SALT=

# Server-only payment configuration (Paystack).
# PAYMENT_PUBLIC_KEY is reserved for provider configuration; checkout currently initializes server-side.
# For Paystack, set PAYMENT_WEBHOOK_SECRET to the secret used for Paystack webhook HMAC signatures.
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
