# Public site URL used for canonical links, structured data, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=https://cobbinaemmanuel.tech # Public site name used for social cards and structured data.

# Google Search Console verification token only (not the complete meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase public settings. The anon key is safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ANALYTICS_SALT=

# Server-only payment configuration (Paystack).
# PAYMENT_PUBLIC_KEY is reserved for provider configuration; checkout currently initializes server-side.
# For Paystack, set PAYMENT_WEBHOOK_SECRET to the secret used for Paystack webhook HMAC signatures.
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# AWS S3 Asset Library (server-only). Both buckets can remain private.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary IAM credentials.
AWS_SESSION_TOKEN=
AWS_S3_RESOURCE_BUCKET=
AWS_S3_MEDIA_BUCKET=
# Browser/admin upload limit in megabytes. Defaults to 250 if omitted.
AWS_S3_UPLOAD_MAX_MB=250

# Transactional email notifications (Resend). Server-only.
# Verify a domain/subdomain in Resend and use an address on that verified domain.
RESEND_API_KEY=Your_Resend_API_key
EMAIL_FROM=Your Name <your.email@example.com>
# Defaults to siteConfig.email when omitted, but set explicitly in production if preferred.
CONSULTATION_NOTIFICATION_EMAIL=The_email_for_receiving_consultation

# Optional: international storefront price display. Checkout remains in the resource's canonical currency.
# Free ExchangeRate-API account key. Used server-side and cached daily.
EXCHANGE_RATE_API_KEY=
# Optional fallback: USD value of 1 GHS, e.g. 0.08. Used only if the API key is absent/unavailable.
GHS_TO_USD_DISPLAY_RATE=
